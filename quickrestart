#!/bin/bash
set -e

cd /srv/peck/management

git pull --ff-only

sudo -u peck php artisan down
trap 'sudo -u peck php artisan up' EXIT

sudo -u peck php artisan optimize:clear
sudo -u peck php artisan optimize
sudo -u peck php artisan reload

sudo systemctl reload php8.4-fpm

echo "Server updated successfully"

